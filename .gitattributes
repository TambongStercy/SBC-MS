# Normalize line endings. The repo currently has ~650 files that differ from
# HEAD only by CRLF vs LF, which buries real diffs.
#
# This file stops the churn recurring. To clear the existing churn, run once
# and commit on its own (it is a large, mechanical commit — worth owning
# separately so it never mixes with a feature diff):
#
#   git add --renormalize .
#   git commit -m "chore: normalize line endings to LF"
#
* text=auto eol=lf

# Binary / generated — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
package-lock.json -diff
