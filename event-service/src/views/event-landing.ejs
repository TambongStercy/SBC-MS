<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= event.title %> · SBC Event</title>
    <meta name="description" content="<%= descriptionPreview %>">

    <!-- Open Graph for WhatsApp / Facebook -->
    <meta property="og:type" content="event">
    <meta property="og:title" content="<%= event.title %>">
    <meta property="og:description" content="<%= descriptionPreview %>">
    <meta property="og:url" content="<%= canonicalUrl %>">
    <% if (posterUrl) { %><meta property="og:image" content="<%= posterUrl %>"><% } %>

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= event.title %>">
    <meta name="twitter:description" content="<%= descriptionPreview %>">
    <% if (posterUrl) { %><meta name="twitter:image" content="<%= posterUrl %>"><% } %>

    <style>
        :root {
            --bg: #f5f6f8; --card: #ffffff; --text: #14161a;
            --muted: #5d6673; --accent: #115CF6; --border: #e3e6eb;
        }
        @media (prefers-color-scheme: dark) {
            :root { --bg: #0f1115; --card: #191c23; --text: #f2f4f8; --muted: #9aa3b2; --border: #262a33; }
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background: var(--bg); color: var(--text);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            line-height: 1.5; padding: 16px;
            display: flex; flex-direction: column; align-items: center;
        }
        .card {
            background: var(--card); border: 1px solid var(--border);
            border-radius: 16px; overflow: hidden;
            width: 100%; max-width: 480px;
        }
        .poster { width: 100%; display: block; background: #000; }
        .poster img { width: 100%; height: auto; display: block; max-height: 70vh; object-fit: cover; }
        .body { padding: 20px; }
        h1 { font-size: 1.25rem; font-weight: 650; margin-bottom: 8px; }
        .meta { color: var(--muted); font-size: 0.9rem; margin-bottom: 4px; }
        .price { color: var(--accent); font-weight: 600; margin: 12px 0; }
        p.desc { color: var(--muted); font-size: 0.95rem; white-space: pre-wrap; margin: 12px 0 20px; }
        a.btn {
            display: block; text-decoration: none; text-align: center;
            padding: 14px 16px; border-radius: 10px;
            background: var(--accent); color: white; font-weight: 600;
        }
        a.btn.secondary {
            background: transparent; color: var(--accent);
            border: 1px solid var(--accent); margin-top: 8px;
        }
        .badge {
            display: inline-block;
            padding: 2px 8px; border-radius: 999px;
            background: #dbeafe; color: #1e40af;
            font-size: 0.7rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.5px;
            margin-bottom: 8px;
        }
    </style>
</head>
<body>
    <div class="card">
        <% if (posterUrl) { %>
            <div class="poster"><img src="<%= posterUrl %>" alt="<%= event.title %>"></div>
        <% } %>
        <% if (videoUrl) { %>
            <div class="poster" style="background:#000;">
                <video src="<%= videoUrl %>" <% if (posterUrl) { %>poster="<%= posterUrl %>" <% } %>controls playsinline preload="metadata" style="width:100%;max-height:70vh;display:block;"></video>
            </div>
        <% } %>
        <div class="body">
            <span class="badge"><%= event.category || 'Événement' %></span>
            <h1><%= event.title %></h1>
            <div class="meta">📅 <%= startsAtFormatted %></div>
            <div class="meta">📍 <%= event.venue %> · <%= event.city %></div>
            <% if (priceFrom) { %>
                <div class="price">à partir de <%= priceFrom.toLocaleString('fr-FR') %> XAF</div>
            <% } %>
            <p class="desc"><%= descriptionPreview %></p>
            <a href="<%= appUrl %>" class="btn">Ouvrir dans SBC</a>
            <a href="https://sniperbuisnesscenter.com" class="btn secondary">Découvrir SBC</a>
        </div>
    </div>
</body>
</html>
