NODE_ENV=development
PORT=3011
HOST=0.0.0.0

MONGODB_URI=mongodb://localhost:27017/sbc_event_dev
MONGO_MAX_POOL_SIZE=20
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Auth (must match gateway/user-service)
JWT_SECRET=
SERVICE_SECRET=

# Sibling services
USER_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3003
SETTINGS_SERVICE_URL=http://localhost:3007

# Public URLs
PUBLIC_BASE_URL=http://localhost:3011
APP_BASE_URL=https://sniperbuisnesscenter.com
SELF_BASE_URL=http://localhost:3011
MEDIA_CDN_BASE_URL=https://storage.googleapis.com/sbc-file-storage

# QR signing (HMAC)
QR_TOKEN_SECRET=

# Commissions (fallback if settings-service unreachable)
PRIMARY_COMMISSION_PCT=0.05
RESALE_COMMISSION_PCT=0.10
DEFAULT_MAX_RESALE_PRICE_PCT=120

# Minimums (XAF)
MIN_WITHDRAWAL_AMOUNT=2000

# Feature flag: empty = live for everyone; ISO instant = live at that time; keeps
# admins/testers unblocked while non-admins wait.
EVENT_LAUNCH_AT=

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=300000

# Notification channels used by every event notification (spec §23), in order of
# attempt. Each is best-effort and independent: a dead SMS provider still lets the
# email and the in-app/push record through. Drop `sms` to stop paying per message,
# or set to `email` alone for the pre-multi-channel behaviour.
# Known today: `email` and `sms` really deliver (SMS needs SMS_PROVIDER configured
# on notification-service, else it's a no-op outside dev); `push` only writes an
# in-app notification row — notification-service has no device delivery yet.
EVENT_NOTIFY_CHANNELS=push,email,sms
