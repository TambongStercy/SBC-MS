{
    "name": "event-service",
    "version": "1.0.0",
    "description": "Microservice for the SBC Event ticketing platform and resale marketplace",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc && npm run copy:assets",
        "copy:assets": "mkdir -p dist/views dist/public && cp -r src/views/. dist/views/ 2>/dev/null || true && cp -r src/public/. dist/public/ 2>/dev/null || true",
        "start": "node dist/server.js",
        "dev": "nodemon --exec ts-node src/server.ts",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix"
    },
    "keywords": [
        "microservice",
        "events",
        "tickets",
        "resale"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "axios": "^1.7.2",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "ejs": "^3.1.10",
        "express": "^4.19.2",
        "express-rate-limit": "^7.5.1",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.5.1",
        "nanoid": "^3.3.4",
        "pino": "^9.3.1",
        "pino-pretty": "^11.2.1",
        "qrcode": "^1.5.4",
        "slugify": "^1.6.6"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/ejs": "^3.1.5",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node": "^20.14.10",
        "@types/qrcode": "^1.5.6",
        "@typescript-eslint/eslint-plugin": "^7.16.0",
        "@typescript-eslint/parser": "^7.16.0",
        "eslint": "^8.57.0",
        "nodemon": "^3.1.4",
        "ts-node": "^10.9.2",
        "typescript": "^5.5.3"
    }
}
