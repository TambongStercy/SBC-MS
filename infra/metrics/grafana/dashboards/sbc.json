{
 "uid": "sbc-overview",
 "title": "SBC : santé des services",
 "tags": [
  "sbc"
 ],
 "timezone": "Africa/Douala",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "env",
    "label": "Environnement",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up{job=\"sbc\", env!=\"shared\"}, env)",
     "refId": "env"
    },
    "current": {
     "text": "preprod",
     "value": "preprod"
    },
    "refresh": 1
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requêtes par seconde",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service) (rate(sbc_http_request_duration_seconds_count{env=\"$env\"}[5m]))",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Part d’erreurs serveur (5xx)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service) (rate(sbc_http_request_duration_seconds_count{env=\"$env\",code=\"5xx\"}[5m])) / sum by (service) (rate(sbc_http_request_duration_seconds_count{env=\"$env\"}[5m]))",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Temps de réponse p95",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(sbc_http_request_duration_seconds_bucket{env=\"$env\",route!=\"unmatched\"}[5m])))",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Temps de réponse p50 / p99 (tous services)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(sbc_http_request_duration_seconds_bucket{env=\"$env\",route!=\"unmatched\"}[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(sbc_http_request_duration_seconds_bucket{env=\"$env\",route!=\"unmatched\"}[5m])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 5,
   "type": "table",
   "title": "Routes les plus lentes (p95, 1 h)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 9
