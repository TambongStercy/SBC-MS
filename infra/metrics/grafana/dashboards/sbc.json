     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Routes argent : erreurs 5xx / min",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 25,
    "w": 12,
    "h": 8
