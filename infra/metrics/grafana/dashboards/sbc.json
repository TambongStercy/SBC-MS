    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(15, histogram_quantile(0.95, sum by (le, service, route) (rate(sbc_http_request_duration_seconds_bucket{env=\"$env\",route!=\"unmatched\"}[1h]))))",
     "legendFormat": "{{service}} {{route}}",
     "instant": true,
     "format": "table"
    }
   ],
   "options": {
    "sortBy": [
     {
      "displayName": "Value",
      "desc": true
     }
    ]
   }
  },
  {
