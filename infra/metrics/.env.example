# /opt/metrics/.env on the secondary server, mode 600. Generated on the server, never printed.
GRAFANA_ADMIN_PASSWORD=          # openssl rand -base64 24
# Alerts → ntfy. Public server (https://ntfy.sh): a long random topic is the only secret
# (openssl rand -hex 16). Own server: its URL, and NTFY_TOKEN for a protected topic.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# /opt/metrics/secrets/ (mode 600, readable by uid 65534):
#   metrics_token      the same value as METRICS_TOKEN in the five services' .env
#   main-metrics.crt   the main server's /etc/nginx/ssl/sbc-metrics.crt (public certificate)
