# risk-service (Security plan Phase 4): the fraud engine. Internal only, never behind the gateway.
PORT=3013                       # preprod 6013
MONGODB_URI=mongodb://localhost:27017/sbc_risk   # preprod sbc_risk_preprod
SERVICE_SECRET=                 # same as the other services
# HMAC key for numbers and devices (stored hashed only). openssl rand -base64 32. One per environment, NEVER rotate:
# a new key makes every stored identifier unmatchable.
RISK_HASH_KEY=
REDIS_URL=redis://127.0.0.1:6379  # optional: decisions cached 10 min
SUPPORT_SERVICE_URL=http://localhost:3012  # preprod :6012; without it cases are only logged
# Tuning (defaults shown)
RISK_HUB_THRESHOLD=50           # an identifier shared by more accounts links nothing (shop number, carrier)
RISK_REQUIRE_CODE_AT=40
RISK_HOLD_AT=70
RISK_DISABLED_RULES=            # e.g. quick_withdrawal,multi_account
LOG_LEVEL=info

# Look-back only (scripts/lookback.js), read-only:
# SOURCE_USERS_MONGODB_URI=mongodb://localhost:27017/sbc_users
# SOURCE_PAYMENT_MONGODB_URI=mongodb://localhost:27017/sbc_payment

# Security plan Phase 8: KYC level 1 (kyc-worker on the secondary server). Off unless the first three are set.
# KYC_WORKER_URL=https://preprod-kyc.sniperbusinesscenter.com   # prod: kyc.sniperbusinesscenter.com
# KYC_SHARED_SECRET=            # same value as the worker's .env; openssl rand -hex 32, never printed
# USERS_MONGODB_URI=mongodb://localhost:27017/sbc_users_preprod   # read-only use (prod: sbc_users)
# KYC_PER_SECOND=50             # members per second (one batch a second)
# KYC_NIGHT_FROM=2              # backfill / nightly refresh window, Douala hours
# KYC_NIGHT_TO=5
# KYC_BACKFILL_ANYTIME=false    # preprod tests only
# KYC_RETENTION_DAYS=365        # results deleted after (TTL)
# KYC_EMAIL_VARIANT_POINTS=20
# KYC_DISABLED=false
