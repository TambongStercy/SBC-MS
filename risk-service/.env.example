# risk-service (Security plan Phase 4): the fraud engine. Internal only, never behind the gateway.
PORT=3013                       # preprod 6013
MONGODB_URI=mongodb://localhost:27017/sbc_risk   # preprod sbc_risk_preprod
SERVICE_SECRET=                 # same as the other services
# HMAC key for numbers and devices (stored hashed only). openssl rand -base64 32. One per environment, NEVER rotate:
# a new key makes every stored identifier unmatchable.
RISK_HASH_KEY=
REDIS_URL=redis://127.0.0.1:6379  # optional: decisions cached 10 min
SUPPORT_SERVICE_URL=http://localhost:3012  # preprod :6012; without it cases are only logged
# Tuning (defaults shown)
RISK_HUB_THRESHOLD=50           # an identifier shared by more accounts links nothing (shop number, carrier)
RISK_REQUIRE_CODE_AT=40
RISK_HOLD_AT=70
RISK_DISABLED_RULES=            # e.g. quick_withdrawal,multi_account
LOG_LEVEL=info

# Source databases, READ-ONLY (Phase 4 part 2 live events + weekly rebuild; USERS_ is also KYC's).
# Live events and the rebuild are off unless both are set.
# USERS_MONGODB_URI=mongodb://localhost:27017/sbc_users_preprod     # prod: sbc_users
# PAYMENT_MONGODB_URI=mongodb://localhost:27017/sbc_payment_preprod # prod: sbc_payment
# RISK_LIVE_DISABLED=false      # true: no events handled, no watcher, no rebuild
# RISK_EVENTS_PER_SECOND=50
# RISK_WATCH_EVERY_SEC=15       # new withdrawals read from the payment database
# RISK_MAX_GROUP=500            # linked group cut at this size when rescored live
# RISK_REBUILD_DAY=0            # weekly full rebuild: Douala weekday (0 = Sunday)…
# RISK_REBUILD_HOUR=1           # …and hour
# RISK_REBUILD_DISABLED=false
# RISK_SIGNUP_BURST=5           # sign-ups under one sponsor from one network/device in 24 h
# RISK_DATACENTER_ASNS=         # extra hosting/VPN ASNs, comma-separated
# RISK_EVENT_RETENTION_DAYS=90

# Look-back only (scripts/lookback.js), read-only:
# SOURCE_USERS_MONGODB_URI=mongodb://localhost:27017/sbc_users
# SOURCE_PAYMENT_MONGODB_URI=mongodb://localhost:27017/sbc_payment

# Security plan Phase 8: KYC level 1. Since 2026-11-22 it runs entirely on the secondary server
# (kyc-worker + kyc-runner: queue, pacing, checks, results); risk-service only submits members
# and reads results. Off unless the first three are set.
# KYC_WORKER_URL=https://preprod-kyc.sniperbusinesscenter.com   # prod: kyc.sniperbusinesscenter.com
# KYC_SHARED_SECRET=            # same value as the worker's .env; openssl rand -hex 32, never printed
# (USERS_MONGODB_URI above)
# KYC_NIGHT_FROM=2              # the nightly sync runs at KYC_NIGHT_FROM:05 Douala
# KYC_NIGHT_TO=5
# (KYC_PER_SECOND, KYC_BACKFILL_ANYTIME, KYC_RETENTION_DAYS, KYC_EMAIL_VARIANT_POINTS: secondary .env)
# KYC_DISABLED=false

# Metrics for Prometheus (GET /metrics, Bearer token). 32+ characters, the same in the five services
# and in /opt/metrics/secrets/metrics_token on the secondary. Empty = /metrics answers 404.
METRICS_TOKEN=
