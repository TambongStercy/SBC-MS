{
    "name": "support-service",
    "version": "1.0.0",
    "description": "SBC Support: agent desk, member help, tickets, cases, view verifications",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc -p tsconfig.build.json && npm run copy:assets",
        "copy:assets": "mkdir -p dist/data && cp -r src/data/. dist/data/",
        "start": "node dist/server.js",
        "dev": "nodemon --exec ts-node src/server.ts",
        "test": "jest --runInBand",
        "typecheck": "tsc --noEmit",
        "create-admin": "ts-node src/scripts/create-support-admin.ts",
        "verify-audit": "ts-node src/scripts/verify-audit-chain.ts"
    },
    "license": "ISC",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1161.0",
        "@aws-sdk/s3-request-presigner": "^3.1161.0",
        "argon2": "^0.41.1",
        "bull": "^4.16.5",
        "cookie-parser": "^1.4.7",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "helmet": "^7.1.0",
        "ioredis": "^5.11.1",
        "jsonwebtoken": "^9.0.2",
        "livekit-server-sdk": "2.19.2",
        "mongoose": "^8.5.1",
        "multer": "^2.0.2",
        "otplib": "^12.0.1",
        "pino": "^9.3.1",
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.7",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/multer": "^1.4.12",
        "@types/node": "^20.14.10",
        "@types/qrcode": "^1.5.6",
        "@types/supertest": "^2.0.16",
        "jest": "^29.7.0",
        "nodemon": "^3.1.4",
        "pino-pretty": "^11.2.1",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.5.3"
    }
}
