# support-service (CONTRACT.md §6). The service refuses to start without the
# four secrets marked "required".
NODE_ENV=production
PORT=3012                                   # preprod: 6012
MONGODB_URI=mongodb://localhost:27017/sbc_support   # preprod: sbc_support_preprod
REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=sbc-support:production:  # default derived from NODE_ENV

# required — openssl rand -base64 48 (must differ from JWT_SECRET)
SUPPORT_JWT_SECRET=
# required — 32 bytes, base64: openssl rand -base64 32 (never rotate without re-enrolling every agent)
TOTP_ENC_KEY=
# required — same value as the other services
SERVICE_SECRET=
# required — same value as user-service (member tokens for /me/*)
JWT_SECRET=

USER_SERVICE_URL=http://localhost:3001
PAYMENT_SERVICE_URL=http://localhost:3003
ADVERTISING_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3002
# Security plan Phase 4: fraud engine (member card « Risque »). Preprod http://localhost:6013; empty = not connected.
RISK_SERVICE_URL=http://localhost:3013
# KYC level 3 (ID + selfie, 2026-11-22): the kyc-worker on the secondary server (preprod
# https://preprod-kyc.sniperbusinesscenter.com) and the SAME secret as risk-service's
# KYC_SHARED_SECRET (copied server to server, never printed). Empty = « Identités » answers 503.
KYC_WORKER_URL=
KYC_SHARED_SECRET=

SUPPORT_PUBLIC_URL=https://support.sniperbuisnesscenter.com
SUPPORT_ALLOWED_ORIGINS=https://support.sniperbuisnesscenter.com
MEMBER_APP_URL=https://sniperbuisnesscenter.com

# Anti-robot check: done by the gateway (ALTCHA, ROBOT_CHECK + ALTCHA_HMAC_KEY in gateway-service/.env).

# DeepSeek (optional: the AI level of the assistant stays off without it)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# LiveKit (optional: live ticket updates; both apps poll without it)
# LIVEKIT_URL is what browsers connect to (wss://…); LIVEKIT_HTTP_URL defaults to it with ws→http.
# The support front's CSP (nginx/support-sniper connect-src) must list the same host.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_HTTP_URL=

# ntfy (optional: a phone notification for each new request). NTFY_URL is the server
# (self-hosted, or https://ntfy.sh), NTFY_TOPIC the topic the team's phones subscribe to,
# NTFY_TOKEN an access token when the topic is protected. Without a token, anyone who
# knows the topic name can read the notifications (member name and the start of the
# message), so on ntfy.sh use a protected (reserved) topic.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# OpenReplay (optional: session replays on tickets). The self-hosted dashboard's address,
# e.g. https://replay.sniperbuisnesscenter.com. Only links to this address are kept.
OPENREPLAY_DASHBOARD_URL=

# Cloudflare R2 — same names as settings-service; private bucket for attachments
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=sbc-support-private
# Local development only (leave empty on preprod/prod): an S3-compatible store such as
# MinIO, e.g. http://127.0.0.1:9010, with R2_ACCOUNT_ID left empty.
R2_ENDPOINT=

# Local development only (http): COOKIE_SECURE=false
# JOBS_ENABLED=true

# Metrics for Prometheus (GET /metrics, Bearer token). 32+ characters, the same in the five services
# and in /opt/metrics/secrets/metrics_token on the secondary. Empty = /metrics answers 404.
METRICS_TOKEN=
