# support-service (CONTRACT.md §6). The service refuses to start without the
# four secrets marked "required".
NODE_ENV=production
PORT=3012                                   # preprod: 6012
MONGODB_URI=mongodb://localhost:27017/sbc_support   # preprod: sbc_support_preprod
REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=sbc-support:production:  # default derived from NODE_ENV

# required — openssl rand -base64 48 (must differ from JWT_SECRET)
SUPPORT_JWT_SECRET=
# required — 32 bytes, base64: openssl rand -base64 32 (never rotate without re-enrolling every agent)
TOTP_ENC_KEY=
# required — same value as the other services
SERVICE_SECRET=
# required — same value as user-service (member tokens for /me/*)
JWT_SECRET=

USER_SERVICE_URL=http://localhost:3001
PAYMENT_SERVICE_URL=http://localhost:3003
ADVERTISING_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3002

SUPPORT_PUBLIC_URL=https://support.sniperbuisnesscenter.com
SUPPORT_ALLOWED_ORIGINS=https://support.sniperbuisnesscenter.com
MEMBER_APP_URL=https://sniperbuisnesscenter.com

# Cloudflare Turnstile (optional: login skips it when unset, with a warning in prod)
TURNSTILE_SECRET=

# DeepSeek (optional: the AI level of the assistant stays off without it)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# LiveKit (optional: live ticket updates; both apps poll without it)
# LIVEKIT_URL is what browsers connect to (wss://…); LIVEKIT_HTTP_URL defaults to it with ws→http.
# The support front's CSP (nginx/support-sniper connect-src) must list the same host.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_HTTP_URL=

# Cloudflare R2 — same names as settings-service; private bucket for attachments
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=sbc-support-private

# Local development only (http): COOKIE_SECURE=false
# JOBS_ENABLED=true
