NODE_ENV=development
PORT=3010
HOST=0.0.0.0

MONGODB_URI=mongodb://localhost:27017/sbc_advertising_dev
MONGO_MAX_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Must match user-service / gateway, otherwise every authenticated route 401s
JWT_SECRET=
SERVICE_SECRET=

USER_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3003
SETTINGS_SERVICE_URL=http://localhost:3007

# Origin the tracking links and landing pages are served from. These URLs get
# pasted into WhatsApp statuses, so this must be the PUBLIC address, not localhost,
# in preprod and prod.
PUBLIC_BASE_URL=http://localhost:3010

# --- Commercial rules (defaults follow docs/ADVERTISING-FEATURE-SPEC.md) ---
# What the advertiser pays per unique (day 1) view
ADVERTISER_PRICE_PER_VIEW=3
# What the diffuseur earns per view, one entry per campaign day
DIFFUSEUR_RATES=1,0.5,0.25
MIN_CAMPAIGN_AMOUNT=6000
MIN_WITHDRAWAL_AMOUNT=2000

CAMPAIGN_DURATION_DAYS=3
# Extra days after the run to catch up on missed days before earnings are cancelled
CAMPAIGN_GRACE_DAYS=3
MAX_CAMPAIGNS_PER_DAY=1

# Referral commission on SBC's margin
REFERRAL_CAMPAIGNS_TO_UNLOCK=100
REFERRAL_COMMISSION_RATE=0.20
# Days of being offered campaigns while completing none before the 20% suspends
REFERRAL_INACTIVITY_DAYS=30

# Minimum gap between two campaign days, in hours
MIN_HOURS_BETWEEN_DAYS=24
