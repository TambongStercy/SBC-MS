<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Paiement simulé — SBC Sandbox</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f3f4f6; min-height: 100vh;
            display: flex; align-items: center; justify-content: center; padding: 16px;
        }
        .card {
            background: #fff; border-radius: 16px; padding: 32px 24px;
            max-width: 420px; width: 100%; box-shadow: 0 10px 30px rgba(0, 0, 0, .08);
        }
        .badge {
            display: inline-block; background: #fef3c7; color: #92400e;
            font-size: 12px; font-weight: 700; letter-spacing: .05em;
            padding: 4px 10px; border-radius: 9999px; margin-bottom: 16px;
        }
        h1 { font-size: 20px; color: #111827; margin-bottom: 8px; }
        p.sub { color: #6b7280; font-size: 14px; margin-bottom: 24px; }
        .amount {
            text-align: center; background: #f9fafb; border: 1px solid #e5e7eb;
            border-radius: 12px; padding: 16px; margin-bottom: 24px;
        }
        .amount .value { font-size: 28px; font-weight: 800; color: #111827; }
        .amount .label { font-size: 12px; color: #9ca3af; margin-top: 4px; }
        button {
            width: 100%; border: 0; border-radius: 12px; padding: 14px;
            font-size: 15px; font-weight: 700; cursor: pointer; margin-bottom: 10px;
        }
        button:disabled { opacity: .5; cursor: wait; }
        .ok { background: #115CF6; color: #fff; }
        .ko { background: #fee2e2; color: #b91c1c; }
        .note { font-size: 12px; color: #9ca3af; text-align: center; margin-top: 12px; line-height: 1.5; }
        #error { color: #b91c1c; font-size: 13px; text-align: center; margin-top: 10px; display: none; }
    </style>
</head>

<body>
    <div class="card">
        <span class="badge">SANDBOX — AUCUN ARGENT RÉEL</span>
        <h1>Checkout simulé</h1>
        <p class="sub">Cette page remplace la page de paiement de l'opérateur (préprod uniquement). Choisissez le résultat à simuler.</p>

        <div class="amount">
            <div class="value">
                <%= amount %> <%= currency %>
            </div>
            <div class="label">Session <%= sessionId %></div>
        </div>

        <button class="ok" onclick="resolvePayment('success', this)">✅ Payer — simuler un succès</button>
        <button class="ko" onclick="resolvePayment('fail', this)">❌ Simuler un échec (fonds insuffisants)</button>

        <div id="error"></div>
        <p class="note">Pour simuler un <strong>abandon / timeout</strong>, fermez simplement cette page :
            le paiement restera en attente, comme un vrai checkout abandonné.</p>
    </div>

    <script>
        async function resolvePayment(outcome, btn) {
            document.querySelectorAll('button').forEach(function (b) { b.disabled = true; });
            btn.textContent = 'Traitement…';
            try {
                const res = await fetch('/api/payments/sandbox/checkout/<%= sessionId %>/resolve', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ outcome: outcome })
                });
                const data = await res.json();
                if (!res.ok || !data.success) throw new Error(data.message || 'Échec de la simulation');
                window.location.href = data.data.redirectUrl;
            } catch (err) {
                const el = document.getElementById('error');
                el.textContent = err.message;
                el.style.display = 'block';
                document.querySelectorAll('button').forEach(function (b) { b.disabled = false; });
            }
        }
    </script>
</body>

</html>
