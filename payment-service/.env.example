# FeexPay Configuration
FEEXPAY_API_KEY=your_feexpay_api_key
FEEXPAY_SHOP_ID=your_feexpay_shop_id
FEEXPAY_BASE_URL=https://api.feexpay.me/api
FEEXPAY_WEBHOOK_SECRET=your_webhook_secret

# FeexPay Withdrawals Control
# Set to 'true' to enable FeexPay withdrawals, 'false' or omit to disable
# IMPORTANT: For security reasons, FeexPay withdrawals are disabled by default
FEEXPAY_WITHDRAWALS_ENABLED=false

# Other payment configurations...
CINETPAY_API_KEY=your_cinetpay_api_key
CINETPAY_SITE_ID=your_cinetpay_site_id
# Redis for hot counters (Security plan, utils/redis.ts). Optional: unset = off,
# and every caller falls back (fail open). Use a database number of its own.
# REDIS_URL=redis://127.0.0.1:6379/3
# REDIS_KEY_PREFIX=sbc:payment:   (default)
# REDIS_COMMAND_TIMEOUT_MS=150

# Security plan Phase 10 (payment conversion, part 2)
# Mobile Money number check before FeexPay: log (default) | enforce | off
PAYIN_NUMBER_CHECK=log
# Team alerts (provider drop, error spikes, stuck payments); comma-separated, empty = no e-mail
PAYMENT_ALERT_EMAILS=
# PAYMENT_ALERTS_ENABLED=false
# PAYMENT_ALERT_STUCK=100
# Move abandoned payments (no provider, > 7 days) to paymentintents_archive; never deletes
PAYIN_ARCHIVE_ENABLED=false
# PAYIN_ARCHIVE_AFTER_DAYS=7
# « Contacter le support » on a failed payment: the member app's help section, once SBC Support is live (empty = no button)
SUPPORT_HELP_URL=

# Security plan Phase 2: before a withdrawal or transfer, balances A (account), B (journal)
# and C (Blnk) must agree. off (default) | log (case, never refuses) | enforce (refuses).
LEDGER_TRIPLE_CHECK=off
# Security plan Phase 4: ask the fraud engine before a withdrawal. off (default) | silent (answer logged, never refuses)
RISK_MODE=off
# enforce (decided 2026-11-22): a member the fraud engine holds cannot take money out until support releases them.
# RISK_ENFORCE_TIMEOUT_MS=1500   # no answer within this = refused (never paid blind)
# RISK_FAIL_OPEN=false           # true = let withdrawals through when risk-service does not answer
RISK_SERVICE_URL=http://localhost:3013   # preprod :6013
