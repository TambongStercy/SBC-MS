# User Service Environment Variables

# Server configuration
PORT=3001
NODE_ENV=development # set to 'production' in production

# MongoDB Connection URIs
MONGODB_URI_DEV=mongodb://localhost:27017/sbc_user_dev
MONGODB_URI_PROD=your_production_mongodb_uri_here

# JWT Configuration
JWT_SECRET=your_very_strong_jwt_secret # CHANGE THIS IN PRODUCTION
# Admin sign-in with an authenticator app (required for ANY admin to sign in):
# 32 random bytes in base64 -> openssl rand -base64 32. Never rotate it without
# resetting every admin's authenticator (scripts/reset-admin-authenticator.ts).
ADMIN_TOTP_ENC_KEY=
# Admin session: idle timeout (minutes) and maximum length (hours).
ADMIN_IDLE_TIMEOUT_MIN=30
ADMIN_SESSION_MAX_HOURS=12
# After an admin confirms a money action with their authenticator code, further money actions on the
# same admin session need no new code for this long (minutes, 1–30).
ADMIN_STEPUP_MINUTES=10
# Admin balance adjustments and activation-transfer reversals need the admin's code. false = kill switch.
ADMIN_STEPUP_REQUIRED=true
JWT_EXPIRATION=1d # Example: 1 day expiration

# Service URLs
SERVICE_SECRET=__REPLACE_WITH_STRONG_RANDOM_SECRET__
PAYMENT_SERVICE_URL=http://localhost:3003/api
NOTIFICATION_SERVICE_URL=http://localhost:3002/api
# Add other service URLs if needed (e.g., PRODUCT_SERVICE_URL)

# Self URL (for callbacks, etc.)
SELF_BASE_URL=http://localhost:3001 # URL where this service is reachable by others (e.g., payment service)

# Add other service-specific variables as needed
# e.g., API Keys for external services 
# --- Monthly leaderboard bonus (credited to the ACTIVATION balance) ---
# Off by default: enabling it makes the next 1st of the month move real money.
LEADERBOARD_BONUS_ENABLED=false
LEADERBOARD_BONUS_CRON=0 3 1 * *
LEADERBOARD_BONUS_TZ=Africa/Douala
# First counted month. September 2026 is the first one, so the first payout runs
# on 1 October 2026; every earlier month is refused on every path.
LEADERBOARD_BONUS_FIRST_MONTH=2026-09
# Thresholds and amounts must match the reward table shown in the app
# (ui/src/lib/leaderTiers.ts).
LEADERBOARD_TIER1_SALES=30
LEADERBOARD_TIER1_XAF=2000
LEADERBOARD_TIER2_SALES=120
LEADERBOARD_TIER2_XAF=10000
LEADERBOARD_TIER3_SALES=320
LEADERBOARD_TIER3_XAF=50000

# Withdrawals are blocked this many hours after the account's email or phone
# number changes (utils/withdrawal-lock.ts). Rufus asked for 24 to 48 h.
WITHDRAWAL_LOCK_HOURS_AFTER_CONTACT_CHANGE=48

# Redis for hot counters (Security plan, utils/redis.ts). Optional: unset = off,
# and every caller falls back (fail open). Use a database number of its own.
# REDIS_URL=redis://127.0.0.1:6379/3
# REDIS_KEY_PREFIX=sbc:user:   (default)
# REDIS_COMMAND_TIMEOUT_MS=150

# Member authenticator app (Security plan Phase 3). 32 random bytes, base64, one per
# environment: openssl rand -base64 32. Without it, nobody can set up the app,
# change a payout destination or withdraw (503). Never rotate it: it decrypts
# every member's saved secret.
MEMBER_TOTP_ENC_KEY=
# Security plan Phase 3 part 2:
# AUTHENTICATOR_SETUP_LOCK_HOURS=0      # plan: 24–48; 0 = no withdrawal lock after setting up the app (Rufus picks)
# AUTHENTICATOR_SETUP_REVIEW=log        # log = a risky setup files a support case, the setup stands; off
# AUTHENTICATOR_ADOPTION_JOB_DISABLED=false   # daily share of members above 5,000 F with the app (03:55 Douala)

# Daily activity board (Security plan Phase 11): the rollup runs every minute and
# writes activity_days. true stops it (the admin and support panels keep the last figures).
ACTIVITY_ROLLUP_DISABLED=false

# Security plan Phase 2: second ledger (Blnk, docs/security-plan/phase2-ledger.md).
# Empty = nothing is sent and the blnk-sync worker idles. Blnk listens on 127.0.0.1 only
# and must run with "server.secure": true, or it accepts requests without the key.
BLNK_URL=
BLNK_API_KEY=
BLNK_LEDGER_NAME=SBC members
BLNK_SYNC_DISABLED=false

# Security plan Phase 7: dormant accounts (src/config/dormancy.ts). All optional.
# DORMANCY_INACTIVE_DAYS=90
# DORMANCY_DORMANT_DAYS=180
# DORMANCY_LONG_DORMANT_DAYS=365
# DORMANCY_XAF_PER_USD=660
# Accounts holding less than this (all balances, in XAF) get no status: 0 = any amount.
# DORMANCY_MIN_XAF=500
# off | log (default) | on. "on" holds withdrawals DORMANCY_HOLD_HOURS after a dormant account
# comes back; switch it on once sign-in dates cover 30+ days.
# DORMANCY_REACTIVATION_HOLD=log
# DORMANCY_HOLD_HOURS=72
# DORMANCY_JOB_DISABLED=false
# Phase 7 part 2: réactivation campaign. Anything but "live" sends ONLY to the members listed in
# REACTIVATION_TEST_RECIPIENTS (emails or user ids, comma-separated): keep preprod on the allowlist,
# it holds copies of real members' addresses. Prod: REACTIVATION_SEND_MODE=live once Rufus approved the text.
# REACTIVATION_SEND_MODE=allowlist
# REACTIVATION_TEST_RECIPIENTS=
# REACTIVATION_MIN_DAYS=30
# Fraud flags on the dormant list (risk-service; preprod http://localhost:6013, prod http://localhost:3013).
RISK_SERVICE_URL=
# Security plan Phases 4 + 8: sign-ups, contact/authenticator changes, dormant accounts coming back and
# ledger mismatches are sent to risk-service as events (fire-and-forget, 1 s budget): fraud rules + KYC
# level 1. RISK_EVENTS_DISABLED=true stops them (KYC_HINTS_DISABLED=true too, its former name).
# RISK_EVENTS_DISABLED=false

# Metrics for Prometheus (GET /metrics, Bearer token). 32+ characters, the same in the five services
# and in /opt/metrics/secrets/metrics_token on the secondary. Empty = /metrics answers 404.
METRICS_TOKEN=

# Payout seal (2026-11-22): HMAC of the MoMo/crypto payout destination; a change made outside the
# app (straight in the DB) freezes the money and alerts support. openssl rand -hex 32, never rotate.
PAYOUT_SEAL_KEY=
# Date of the bootstrap (scripts/payout-seal-bootstrap): from then on a missing seal is a tamper too.
PAYOUT_SEAL_SINCE=
# enforce (default: freeze + case) | log (case only) | off
PAYOUT_SEAL_MODE=enforce

# Email verified after payment, not at sign-up (2026-11-23; services/email-verification.service.ts).
# after_payment (default) | at_signup (the code at sign-up again, for everyone)
# SIGNUP_EMAIL_CODE=after_payment
# Accounts created from this date get the blocking « Vérifiez votre e-mail » once paid.
# EMAIL_VERIFY_GATE_SINCE=2026-11-23T00:00:00Z
