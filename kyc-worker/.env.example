# kyc-worker (Security plan Phase 8). On the secondary server: /opt/kyc-<env>/.env, mode 600.
# Same value as risk-service's KYC_SHARED_SECRET. openssl rand -hex 32; generated on the server, never printed.
KYC_SHARED_SECRET=
KYC_DB_PATH=/data/kyc.sqlite   # per-domain DNS answers only
KYC_DNS_TTL_DAYS=7
KYC_DNS_THREADS=16
LOG_LEVEL=INFO

# Level 3: ID document + selfie (2026-11-22). Off while KYC_L3_KEY is empty.
# Encrypts the images at rest; openssl rand -hex 32 on the server, never printed, NEVER rotated
# (images still kept would become unreadable).
KYC_L3_KEY=
KYC_L3_IMAGE_DAYS=30        # images deleted this long after the decision
KYC_L3_UNDECIDED_DAYS=60    # images of a request nobody decided
KYC_L3_RECORD_DAYS=365      # decision + check results (no image)
# Face models (runner, mounted at /models from ./models), from github.com/opencv/opencv_zoo (Apache 2.0):
#   models/face_detection_yunet/face_detection_yunet_2023mar.onnx
#   models/face_recognition_sface/face_recognition_sface_2021dec.onnx
# Without them the requests are still stored and decided; the checks say "engine_unavailable".

# Level 2 (2026-11-23): where else the e-mail address is used (Holehe sign-up checks + Gravatar),
# only for members risk-service flags (score ≥ require_code, a hold, a risky authenticator setup,
# a dormant account back, a contact change while flagged). Run by the kyc-l2 container.
KYC_L2_MODE=off              # off | log (looked up, recorded, shown to support; no decision reads it)
KYC_L2_ONLY_EMAILS=          # comma list: when set, only these addresses are ever looked up (preprod: test addresses only)
KYC_L2_PER_DAY=500           # lookups per Douala day; beyond, the queue waits for the next day
KYC_L2_MIN_GAP_S=60          # seconds between two lookups
KYC_L2_MODULE_PER_HOUR=30    # each site asked at most this often an hour
KYC_L2_MODULE_TIMEOUT_S=15
KYC_L2_MODULES=              # empty = the 20 default sign-up checks (app/l2_checks.py DEFAULT_MODULES);
                             # only "register" modules outside porn/medical/osint can ever run
KYC_L2_RECHECK_DAYS=90       # a member (or the same address) is not looked up again before this
KYC_L2_RETENTION_DAYS=365
KYC_L2_NO_FOOTPRINT_POINTS=15
KYC_L2_ESTABLISHED_POINTS=-10
