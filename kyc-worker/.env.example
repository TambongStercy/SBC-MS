# kyc-worker (Security plan Phase 8). On the secondary server: /opt/kyc-<env>/.env, mode 600.
# Same value as risk-service's KYC_SHARED_SECRET. openssl rand -hex 32; generated on the server, never printed.
KYC_SHARED_SECRET=
KYC_DB_PATH=/data/kyc.sqlite   # per-domain DNS answers only
KYC_DNS_TTL_DAYS=7
KYC_DNS_THREADS=16
LOG_LEVEL=INFO

# Level 3: ID document + selfie (2026-11-22). Off while KYC_L3_KEY is empty.
# Encrypts the images at rest; openssl rand -hex 32 on the server, never printed, NEVER rotated
# (images still kept would become unreadable).
KYC_L3_KEY=
KYC_L3_IMAGE_DAYS=30        # images deleted this long after the decision
KYC_L3_UNDECIDED_DAYS=60    # images of a request nobody decided
KYC_L3_RECORD_DAYS=365      # decision + check results (no image)
# Face models (runner, mounted at /models from ./models), from github.com/opencv/opencv_zoo (Apache 2.0):
#   models/face_detection_yunet/face_detection_yunet_2023mar.onnx
#   models/face_recognition_sface/face_recognition_sface_2021dec.onnx
# Without them the requests are still stored and decided; the checks say "engine_unavailable".
