{
    "compilerOptions": {
        "target": "es2018",
        "module": "commonjs",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "altcha-lib": [
                "node_modules/altcha-lib/dist/cjs/v2/index.d.ts",
                "node_modules/altcha-lib/dist/esm/v2/index.d.ts"
            ],
            "altcha-lib/algorithms/sha": [
                "node_modules/altcha-lib/dist/cjs/v2/algorithms/sha.d.ts",
                "node_modules/altcha-lib/dist/esm/v2/algorithms/sha.d.ts"
            ]
        }
    },
    "ts-node": {
        "swc": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "**/*.test.ts"
    ]
}
