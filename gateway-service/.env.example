# Gateway service configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*

# Service secrets
SERVICE_SECRET=#
JWT_SECRET=#

# Microservice URLs (update to match your deployment environment)
USER_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3003
PRODUCT_SERVICE_URL=http://localhost:3004
ADVERTISING_SERVICE_URL=http://localhost:3005
TOMBOLA_SERVICE_URL=http://localhost:3006
SETTINGS_SERVICE_URL=http://localhost:3007
# Redis for hot counters (Security plan, utils/redis.ts). Optional: unset = off,
# and every caller falls back (fail open). Use a database number of its own.
# REDIS_URL=redis://127.0.0.1:6379/3
# REDIS_KEY_PREFIX=sbc:gateway:   (default)
# REDIS_COMMAND_TIMEOUT_MS=150

# Security plan Phase 9: signed-request / browser checks. off (default) | log (record only, never refuses)
BROWSER_CHECKS=off
# Free IP → country / network files (sapics ip-location-db, public domain; no key). The folder the
# nightly scripts/security-plan/update-ip-geo.sh fills; unset = off (headers left as nginx set them).
# One copy serves prod and preprod: IPGEO_DIR=/home/sterling/sbc-ipgeo
IPGEO_DIR=
# Phase 9 part 2: members seen using automation (bad signature, replay, body changed, tool) go to the
# fraud engine as events (risk-service; preprod http://localhost:6013, prod http://localhost:3013). Empty = off.
RISK_SERVICE_URL=
# Phase 9 rule 3: anti-robot check (ALTCHA, self-hosted proof of work) on sign-in, sign-up, password
# reset, contact/payout change, authenticator setup, withdrawal, desk login, public support form.
# off (default) | log (count only) | enforce (403 ROBOT_CHECK_FAILED). Needs ALTCHA_HMAC_KEY
# (openssl rand -hex 32, one per environment, never printed); without it the check stays off.
ROBOT_CHECK=off
# With ROBOT_CHECK=log, refuse only these actions (2026-11-23: sign-up has no e-mailed code any more).
# ROBOT_CHECK_ENFORCE=login,signup
# Security plan Phase 9 (cookie sessions): refuse our own web app's member Bearer tokens once the
# 10-minute log line shows webBearer≈0. allow (default) | refuse
# WEB_BEARER=allow
# Extra origins allowed to send cookie-authenticated changes (own host always allowed).
# SESSION_ALLOWED_ORIGINS=
ALTCHA_HMAC_KEY=
# ALTCHA_MAX_COUNTER=20000   (work asked: answer between max/4 and max; ~1.4 s average on a very slow phone)

# Metrics for Prometheus (GET /metrics, Bearer token). 32+ characters, the same in the five services
# and in /opt/metrics/secrets/metrics_token on the secondary. Empty = /metrics answers 404.
METRICS_TOKEN=
