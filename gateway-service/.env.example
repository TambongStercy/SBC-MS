# Gateway service configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*

# Service secrets
SERVICE_SECRET=#
JWT_SECRET=#

# Microservice URLs (update to match your deployment environment)
USER_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3003
PRODUCT_SERVICE_URL=http://localhost:3004
ADVERTISING_SERVICE_URL=http://localhost:3005
TOMBOLA_SERVICE_URL=http://localhost:3006
SETTINGS_SERVICE_URL=http://localhost:3007
# Redis for hot counters (Security plan, utils/redis.ts). Optional: unset = off,
# and every caller falls back (fail open). Use a database number of its own.
# REDIS_URL=redis://127.0.0.1:6379/3
# REDIS_KEY_PREFIX=sbc:gateway:   (default)
# REDIS_COMMAND_TIMEOUT_MS=150

# Security plan Phase 9: signed-request / browser checks. off (default) | log (record only, never refuses)
BROWSER_CHECKS=off
# Phase 9 part 2: members seen using automation (bad signature, replay, body changed, tool) go to the
# fraud engine as events (risk-service; preprod http://localhost:6013, prod http://localhost:3013). Empty = off.
RISK_SERVICE_URL=
